# Copy to .env. The commented settings are optional and show their default.
ANTHROPIC_API_KEY=
# Screens every tool result for prompt injection with TypeSafe's Jev model. Each request and
# every tool result are sent to TypeSafe's API.
TYPESAFE_API_KEY=
# Encrypts each employee's MCP tokens and conversations. Make a key with:
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# One Fernet key, or several separated by commas, newest first; the newest encrypts, all decrypt.
DESKCLERK_TOKEN_KEY=
# Signs the sign-in cookies; at least 32 characters. Make one with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DESKCLERK_SESSION_KEY=
# Any secret can come from a file instead: set DESKCLERK_TOKEN_KEY_FILE=/run/secrets/token_key.
# The Postgres database that holds all state; this is the one compose.yaml starts. Several
# copies of the app can share one database. compose.prod.yaml sets this itself from POSTGRES_PASSWORD.
DESKCLERK_DATABASE_URL=postgresql://deskclerk:deskclerk@127.0.0.1:5432/deskclerk
# The password of the postgres service in compose.prod.yaml; letters and digits only.
POSTGRES_PASSWORD=

# Start without a TypeSafe key.
# DESKCLERK_ALLOW_UNSCREENED=false
# Let Jev pick the servers a request needs, when there are two or more.
# DESKCLERK_TOOL_SELECTION=false

# The company login, an OpenID Connect provider. The issuer is required; this one is the
# development Keycloak from compose.yaml.
DESKCLERK_ISSUER=http://localhost:8080/realms/deskclerk
# DESKCLERK_CLIENT_ID=deskclerk-api
# DESKCLERK_CLIENT_SECRET=
# The audience a bearer token must carry; the client ID when empty.
# DESKCLERK_AUDIENCE=
# The address employees open. Register <it>/login/callback with the login server, and
# <it>/logout/backchannel as its back-channel logout URL. With https, cookies are Secure.
# DESKCLERK_PUBLIC_URL=http://localhost:8000
# The claim that names an employee. It must never change or be reused: use oid on Entra ID.
# DESKCLERK_USER_CLAIM=sub
# DESKCLERK_SESSION_HOURS=8
# The claim that lists an employee's groups, which a server's groups are matched against.
# DESKCLERK_GROUPS_CLAIM=groups

# The model: anthropic:, openai:, azure_openai: or bedrock_converse: and the model name. Add the
# variables that provider reads, such as OPENAI_API_KEY or the AWS credentials.
# A self-hosted OpenAI-compatible server (Ollama, vLLM, llama.cpp) is openai:<model> with
# OPENAI_BASE_URL set to its address, and any OPENAI_API_KEY value.
# DESKCLERK_MODEL=anthropic:claude-haiku-5-5
# Price a model the price list does not know, such as an Azure deployment, as this model.
# DESKCLERK_PRICE_MODEL=
# none prices every call at 0, for a model the company runs itself.

# Limits. The budget is per employee and per month, in USD.
# DESKCLERK_BUDGET_USD=2.0
# DESKCLERK_REQUESTS_PER_MINUTE=20
# DESKCLERK_STEP_LIMIT=8
# DESKCLERK_ASK_SECONDS=180
# DESKCLERK_TOOL_OUTPUT_CHARS=20000
# DESKCLERK_HISTORY_TOKENS=40000
# Delete conversations unused for this many days. 0 keeps them.
# DESKCLERK_RETENTION_DAYS=0

# SCIM 2.0 offboarding. The bearer token your identity provider sends to <public url>/scim/v2.
# Unset, the endpoints are off. Deactivating or deleting a user there erases their MCP tokens,
# sessions, conversations and spending. Set each user's externalId to their DESKCLERK_USER_CLAIM
# value: objectId on Entra ID, the user id on Okta.
# DESKCLERK_SCIM_TOKEN=

# The audit log is one JSON line per request on standard output. It holds the request text only
# with DESKCLERK_AUDIT_TEXT=true, and an HMAC of the request when DESKCLERK_AUDIT_KEY is set.
# DESKCLERK_AUDIT_TEXT=false
# DESKCLERK_AUDIT_KEY=
# Trace each request to Langfuse.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
